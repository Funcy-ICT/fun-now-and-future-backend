# サイネージの設定。install.sh が ~/fnaf-signage/signage.env にコピーする。書き換えたら再起動する

# 表示するページ。サイネージの画面はフロント担当が作る。URL は未定
SIGNAGE_URL="https://example.com/"

# 画面を点ける時刻と消す時刻（24時間表記、時:分）。バックエンドの稼働時間帯（既定は7〜22時）に合わせる
DISPLAY_ON="07:00"
DISPLAY_OFF="22:00"

# 画面の出力名。空なら、wlr-randr の最初の出力を使う。例: HDMI-A-1
DISPLAY_OUTPUT=""
