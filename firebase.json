{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
	  "legacyFunctionsManifest": "true",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
	"public": "public",
	"rewrites": [
		{
			"source": "**",
			"function": "api"
		}
	]
  },
  "emulators": {
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
