{
  "name": "functions",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=lib/index.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,hosting",
    "shell": "npm run build && firebase functions:shell",
    "start": "node lib/index.js",
    "deploy": "firebase deploy --only functions",
    "test": "firebase emulators:exec --only firestore --project fun-now-and-future \"jest\"",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.3.2",
    "hono": "^4.12.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "esbuild": "^0.28.1",
    "firebase-functions-test": "^3.5.0",
    "jest": "^30.4.2",
    "node-mocks-http": "^1.18.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.0"
  },
  "private": true
}
